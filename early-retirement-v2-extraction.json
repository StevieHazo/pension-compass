  "calculationFormulas": {
    "C80": "=VLOOKUP(Scheme,tabNPA,2,0)",
    "G80": "=resdaySPD",
    "H80": "=resdaySPD",
    "C81": "=ROUND(YEAR(ERetDate)-YEAR(DOB)+(ERetDate-DATE(YEAR(ERetDate),MONTH(DOB),DAY(DOB)))/365,4)",
    "G81": "=resdSPA_CYM",
    "H81": "=resdSPA_CYM",
    "C82": "=DATE(YEAR(DOB)+dMinERA,MONTH(DOB),DAY(DOB))",
    "G82": "=resdSPA_CY",
    "H82": "=resdSPA_CY",
    "G83": "=ROUND((resdSPA_CYM-resdSPA_CY)*12,0)",
    "H83": "=resdSPA_CYM-resdSPA_CY",
    "C87": "=SUM(YEAR(ERetDate)-YEAR(DOB))",
    "F87": "=\"ERF at \"&resdSPA_CY&\"_\"&yrsAdjust&\"Y\"&iAgeColLookupMonths&\"M\"",
    "G87": "=VLOOKUP(resdSPA_CY&\"_\"&yrsAdjust&\"Y\"&iAgeColLookupMonths&\"M\",tabAlphaERF,2,0)",
    "C88": "=SUM(MONTH(ERetDate)-MONTH(DOB))",
    "F88": "=\"ERF at \"&resdSPA_CY+1&\"_\"&yrsAdjust+1&\"Y\"&iAgeColLookupMonths&\"M\"",
    "G88": "=VLOOKUP(resdSPA_CY+1&\"_\"&yrsAdjust+1&\"Y\"&iAgeColLookupMonths&\"M\",tabAlphaERF,2,0)",
    "C89": "=SUM(DAY(ERetDate)-DAY(DOB))",
    "G89": "=ROUND((G83*P2ERFTableX1+(12-G83)*P2ERFTableX)/12,4)",
    "C90": "=IF((daysDiffDOBERD<0),(mthsDiffDOBERD-1),mthsDiffDOBERD)",
    "C91": "=IF((C90<0),(yrsDiffDOBERD-1),yrsDiffDOBERD)",
    "C92": "=yrsAdjust-48",
    "C93": "=iAgeColLookupYears_50-5",
    "C94": "=IF((mthsAdjust<0),(mthsAdjust+12),mthsAdjust)",
    "C95": "=yrsAdjust&\" Years \"&IF(iAgeColLookupMonths>0,iAgeColLookupMonths&\" Month\",\"\")&IF(iAgeColLookupMonths>1,\"s\",\"\")",
    "C98": "=IF((dAgeERD<dNPA),VLOOKUP(iAgeColLookupMonths,tabARRPenC_CP_P,iAgeColLookupYears_50),1)",
    "C99": "=IF((dAgeERD<dNPA),VLOOKUP(iAgeColLookupMonths,tabARRLSC_CP,iAgeColLookupYears_50),1)",
    "C100": "=IF((dAgeERD<dNPA),VLOOKUP(iAgeColLookupMonths,tabARRPenP,iAgeColLookupYears_50),1)",
    "C102": "=MAX(0,dNPA-dAgeERD)",
    "C103": "=MIN(yrsEarly,5)",
    "C104": "=MAX(0,MIN(yrsEarly-5,65-dMinERA))",
    "C105": "=ROUND((yrsAt5pc*0.05)+(yrsAt3*0.03),3)",
    "C108": "=ROUND((UnReducedPenRetDate*ERFPen_60),2)",
    "G108": "=ROUND((UnReducedPenRetDate_Alpha*ERFPen_Alpha),2)",
    "C109": "=ROUND((UnReducedLSRetDate*ERFLS_60),2)",
    "C110": "=ROUND((UnReducedPenRetDate*ERFPen_65),2)",
    "C111": "=ROUND((UnReducedPenRetDate*(1-ERFPen_nuvos)),2)",
    "C114": "=VLOOKUP(iAgeColLookupMonths,tabARRBuyout_PA60,iAgeColLookupYears_50)",
    "F114": "=\"BuyOut factor at  \"&resdSPA_CY&\"_\"&yrsAdjust&\"Y\"&iAgeColLookupMonths&\"M\"",
    "G114": "=VLOOKUP(resdSPA_CY&\"_\"&yrsAdjust&\"Y\"&iAgeColLookupMonths&\"M\",tabAlphaBuyout,2,0)",
    "C115": "=VLOOKUP(iAgeColLookupMonths,tabARRBuyoutP_PA65,iAgeColLookupYears_55)",
    "F115": "=\"Buyout factor at \"&resdSPA_CY+1&\"_\"&yrsAdjust+1&\"Y\"&iAgeColLookupMonths&\"M\"",
    "G115": "=VLOOKUP(resdSPA_CY+1&\"_\"&yrsAdjust+1&\"Y\"&iAgeColLookupMonths&\"M\",tabAlphaBuyout,2,0)",
    "C116": "=VLOOKUP(iAgeColLookupMonths,tabARRBuyout_nuvos,iAgeColLookupYears_55)",
    "G116": "=ROUND((G83*P2BuyOutX1+(12-G83)*P2BuyOutX)/12,4)",
    "C120": "=ROUND((BuyOutF_60*UnReducedPenRetDate),2)",
    "G120": "=ROUND((BuyOutF_Alpha*UnReducedPenRetDate_Alpha),2)",
    "C121": "=ROUND(UnReducedLSRetDate*(1-ERFLS_60),2)",
    "C122": "=ROUND((BuyOutF_65*UnReducedPenRetDate),2)",
    "C123": "=ROUND((BuyOutF_Nuvos*UnReducedPenRetDate),2)",
    "C128": "=strToolName&\" - Results\"",
    "C131": "=IF(OR(dAgeERD<=0,ISERROR(dAgeERD)),errError,strAgeUsed)",
    "C134": "=IF(ISERROR(dNPA),errError,dNPA)",
    "G134": "=IF(ISERROR(resstrSPA),errError,resstrSPA)",
    "C136": "=IF((Scheme=\"nuvos\"),IF(ISERROR(ARRPenBen_nuvos),errError,ARRPenBen_nuvos),\nIF((Scheme=\"premium (pension age 65)\"),IF(ISERROR(ARRPenBen_65),errError,ARRPenBen_65),\nIF(ISERROR(ARRPenBen_60),errError,ARRPenBen_60)))",
    "G136": "=IF(ISERROR(ARRPenBen_Alpha),errError,ARRPenBen_nuvos)",
    "C138": "=IF(OR(Scheme=\"classic\",Scheme=\"classic plus\"),UnReducedLSRetDate,errError)",
    "C140": "=IF(OR(Scheme=\"classic\",Scheme=\"classic plus\"),IF(ISERROR(ARRLSBen_60),errError,ARRLSBen_60),errError)",
    "C142": "=IF(Scheme=\"nuvos\",IF(ISERROR(CostOfBuyout_nuvos),errError,CostOfBuyout_nuvos),\nIF((Scheme=\"premium (pension age 65)\"),IF(ISERROR(CostOfBuyout_65),errError,CostOfBuyout_65),\nIF(ISERROR(CostOfBuyout_60),errError,CostOfBuyout_60)))",
    "G142": "=IF(ISERROR(CostOfBuyout_alpha),errError,CostOfBuyout_alpha)",
    "C144": "=IF(OR(Scheme=\"classic\",Scheme=\"classic plus\"),IF(ISERROR(CostARRLS),errError,CostARRLS),errError)"
  },
